// ═════════════ Keyloggers / spyware ═════════════
rule Keylogger_Generic {
  name: "Spyware.Win32.Keylogger.Gen"
  score: 65
  scope: pe, dotnet, script
  desc: "Tuş vuruşu kaydı ve dışarı gönderme"
  strings:
    $k1 = "GetAsyncKeyState" wide ascii
    $k2 = "SetWindowsHookEx" wide ascii
    $k3 = "WH_KEYBOARD_LL" wide ascii
    $w = "GetForegroundWindow" wide ascii
    $t = "GetWindowText" wide ascii
