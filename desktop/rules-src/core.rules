    $a2 = "Document_Open" nocase
    $a3 = "Workbook_Open" nocase
    $o1 = "Chr(" nocase
    $o2 = "StrReverse" nocase
    $o3 = "Base64" nocase
    $o4 = "Lib \"kernel32\"" nocase
    $o5 = "VirtualAlloc" nocase
    $o6 = "RtlMoveMemory" nocase
  condition: any of ($a*) and (#o1 > 20 or $o2 or $o3 or ($o4 and ($o5 or $o6)))
}

