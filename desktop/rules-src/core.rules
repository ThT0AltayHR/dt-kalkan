    $l2 = "[BACKSPACE]" nocase wide ascii
    $l3 = "[CAPSLOCK]" nocase wide ascii
    $l4 = "keylog" nocase wide ascii
    $x1 = "smtp" nocase wide ascii
    $x2 = "api.telegram.org" nocase wide ascii
    $x3 = "discord.com/api/webhooks" nocase wide ascii
