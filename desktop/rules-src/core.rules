// ═════════════ Persistence & defense evasion ═════════════
rule Persistence_Run_Hidden {
  name: "Trojan.Win32.Persistence.Gen"
  score: 40
  scope: pe, script, dotnet
  desc: "Gizli kalıcılık (başlangıç kaydı + gizli kopya + savunmayı devre dışı bırakma)"
  strings:
    $r = "Software\\Microsoft\\Windows\\CurrentVersion\\Run" nocase wide ascii
    $h1 = "attrib +h" nocase wide ascii
    $h2 = "FILE_ATTRIBUTE_HIDDEN" wide ascii
    $d1 = "DisableTaskMgr" nocase wide ascii
    $d2 = "DisableRegistryTools" nocase wide ascii
    $d3 = "DisableAntiSpyware" nocase wide ascii
    $d4 = "EnableLUA" wide ascii
  condition: $r and (any of ($h*)) and any of ($d*)
}

rule Process_Injection_Strings {
  name: "Trojan.Win32.Injector.Gen"
  score: 50
  scope: dotnet, script
  desc: "Başka bir sürece kod enjekte etme API dizisi"
  strings:
    $a = "VirtualAllocEx" wide ascii
    $b = "WriteProcessMemory" wide ascii
    $c = "CreateRemoteThread" wide ascii
    $d = "NtUnmapViewOfSection" wide ascii
    $e = "SetThreadContext" wide ascii
    $f = "QueueUserAPC" wide ascii
    $g = "ResumeThread" wide ascii
  condition: $a and $b and ($c or $f or ($d and $e and $g))
}

rule Shellcode_Patterns {
  name: "Exploit.Win32.Shellcode.Gen"
  score: 55
  scope: pe, script, text, office
  desc: "Bilinen kabuk kodu (shellcode) kalıpları"
  strings:
    $peb32 = { 64 A1 30 00 00 00 }
    $peb64 = { 65 48 8B 04 25 60 00 00 00 }
    $msf1 = { FC E8 82 00 00 00 60 89 E5 31 C0 64 8B 50 30 }
    $msf2 = { FC 48 83 E4 F0 E8 C0 00 00 00 41 51 41 50 52 }
    $hash = { 68 8E 4E 0E EC }
    $ror = { C1 CF 0D 01 C7 }
  condition: $msf1 or $msf2 or ($ror and $hash)
}

rule Webshell_Generic {
  name: "Backdoor.PHP.WebShell"
  score: 75
  scope: script, text
  desc: "Web kabuğu (web shell)"
  strings:
    $a = /eval\s*\(\s*(base64_decode|gzinflate|str_rot13)\s*\(/i
    $b = /(system|passthru|shell_exec|exec)\s*\(\s*\$_(GET|POST|REQUEST)/i
    $c = "<?php" nocase
    $d = /assert\s*\(\s*\$_(POST|GET|REQUEST)/i
  condition: $c and ($a or $b or $d)
}

rule Python_Stealer {
  name: "Trojan.Python.Stealer"
  score: 75
  scope: script, text
  desc: "Python ile yazılmış bilgi hırsızı"
  strings:
    $a = "win32crypt" nocase
    $b = "CryptUnprotectData" nocase
    $c = "Login Data" nocase
    $d = "discord" nocase
    $e = "webhook" nocase
    $f = "requests.post" nocase
    $g = "browser_cookie3" nocase
  condition: ($a or $b) and ($c or $g) and ($e or $f) or ($g and $d and $e)
}

rule Reverse_Shell_Script {
  name: "Backdoor.Script.ReverseShell"
  score: 75
  scope: script, text
  desc: "Ters bağlantı kabuğu (reverse shell)"
  strings:
    $a = /New-Object\s+System\.Net\.Sockets\.TCPClient\s*\(/i
    $b = "GetStream()" nocase
    $c = "iex" nocase
    $d = /bash\s+-i\s+>&\s*\/dev\/tcp\//i
    $e = /socket\.socket\(.*\)\s*;?\s*.*connect\(/i
    $f = "subprocess.call([\"/bin/sh\",\"-i\"])" nocase
    $g = "pty.spawn(" nocase
  condition: ($a and $b and $c) or $d or ($e and ($f or $g))
}
